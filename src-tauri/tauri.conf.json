{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flapcrypt",
  "version": "0.0.8",
  "identifier": "com.olaidigitalstudios.flapcrypt",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flapcrypt - The Mechanical Cryptogram",
        "width": 500,
        "height": 900,
        "minWidth": 420,
        "minHeight": 750,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
