{
  "name": "flapcrypt",
  "private": true,
  "version": "0.0.13",
  "versionCode": 13,
  "type": "module",
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "dev": "vite",
    "dev:web": "vite --mode web",
    "dev:itch": "vite --mode itch",
    "dev:desktop": "vite --mode desktop",
    "dev:playstore": "vite --mode playstore",
    "build": "vite build",
    "build:web": "vite build --mode web --outDir dist/web",
    "build:itch": "vite build --mode itch --outDir dist/itch",
    "build:desktop": "vite build --mode desktop --outDir dist/desktop",
    "build:playstore": "vite build --mode playstore --outDir dist/playstore && cap sync android",
    "build:apk": "npm run build:playstore && cd android && .\\gradlew.bat assembleDebug",
    "build:bundle": "npm run build:playstore && cd android && .\\gradlew.bat bundleRelease",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:windows:init": "tauri-windows-bundle init --all-variants",
    "tauri:msix": "tauri-windows-bundle build --arch x64 --runner npm",
    "tauri:msixbundle": "npm run build:desktop && tauri-windows-bundle build --arch x64 --runner npm",
    "tauri:cert": "powershell -ExecutionPolicy Bypass -File scripts/create-dev-cert.ps1",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.2.0",
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "driver.js": "^1.10.2"
  }
}
